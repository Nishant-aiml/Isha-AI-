<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- USER APP TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- App DP / Logo -->
        <ImageView
            android:id="@+id/imgAppLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/app_dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISHA AI"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100% On-Device Private Assistant"
                android:textSize="11sp"
                android:textColor="#10B981" />
        </LinearLayout>

        <!-- New Chat Session Button -->
        <Button
            android:id="@+id/btnNewChat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="➕ New"
            android:textSize="10sp"
            android:background="@drawable/bg_pill_button"
            android:textColor="#334155"
            android:layout_marginEnd="6dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Live Online RAG Toggle Button -->
        <Button
            android:id="@+id/btnToggleLiveWeb"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🌐 Live Web: ON"
            android:textSize="10sp"
            android:background="@drawable/bg_pill_button"
            android:textColor="#0284C7"
            android:layout_marginEnd="6dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Diagnostics Toggle Button (Discreet for Pro/Devs) -->
        <Button
            android:id="@+id/btnToggleDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⚙️ Dev Specs"
            android:textSize="10sp"
            android:background="@drawable/bg_pill_button"
            android:textColor="#64748B"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- MODERN NAVIGATION TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬 Assistant"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            style="?android:attr/buttonStyleSmall" />

        <Button
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📚 Knowledge &amp; Docs"
            android:backgroundTint="#F1F5F9"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            style="?android:attr/buttonStyleSmall" />
    </LinearLayout>

    <!-- MAIN BODY FRAME -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= CHAT CONSOLE VIEW ================= -->
        <ScrollView
            android:id="@+id/viewChatConsole"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- USER WELCOME HERO CARD -->
                <LinearLayout
                    android:id="@+id/cardWelcomeHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Namaste! How can I help you today?"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I am your offline-first assistant. Ask me questions, consult crop care, check child dosages, or upload documents."
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="6dp" />

                    <!-- Quick suggestion chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/chipRust"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:text="🌾 Wheat yellow rust symptoms and spray dosage"
                            android:textSize="11sp"
                            android:gravity="start|center_vertical"
                            android:background="@drawable/bg_pill_button"
                            android:textColor="#334155"
                            android:layout_marginBottom="6dp"
                            style="?android:attr/borderlessButtonStyle" />

                        <Button
                            android:id="@+id/chipDose"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:text="🩺 What is paracetamol dosage for a 12 kg child?"
                            android:textSize="11sp"
                            android:gravity="start|center_vertical"
                            android:background="@drawable/bg_pill_button"
                            android:textColor="#334155"
                            android:layout_marginBottom="6dp"
                            style="?android:attr/borderlessButtonStyle" />

                        <Button
                            android:id="@+id/chipFIR"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:text="⚖️ Legal process if police station refuses to file FIR"
                            android:textSize="11sp"
                            android:gravity="start|center_vertical"
                            android:background="@drawable/bg_pill_button"
                            android:textColor="#334155"
                            style="?android:attr/borderlessButtonStyle" />
                    </LinearLayout>
                </LinearLayout>

                <!-- COLLAPSIBLE DEVELOPER / DIAGNOSTICS SECTION -->
                <LinearLayout
                    android:id="@+id/panelDevDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Safe Mode Alert -->
                    <LinearLayout
                        android:id="@+id/panelSafeMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FEF3C7"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚠️ SYSTEM SAFE MODE ACTIVE"
                            android:textStyle="bold"
                            android:textColor="#D97706"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/txtSafeModeReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Inference degraded due to system pressure."
                            android:textColor="#D97706"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Hardware Stats Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚙️ Engine &amp; Hardware Telemetry"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/txtColdStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cold Start Latency: -- ms"
                            android:textSize="11sp"
                            android:textColor="#64748B"/>
                        <TextView
                            android:id="@+id/txtTokensPerSec"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generation Speed: -- tok/s"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp"/>
                        <TextView
                            android:id="@+id/txtActiveModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Active Model: UNLOADED"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp"/>
                        <TextView
                            android:id="@+id/txtThermalZone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thermal State: NOMINAL"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Model Registry Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🤖 Local Model Registry"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"/>
                        <ProgressBar
                            android:id="@+id/progressDownload"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone"/>

                        <!-- Model T0 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Battery Saver (0.5B)"
                                android:textSize="11sp"
                                android:textColor="#334155"/>
                            <Button android:id="@+id/btnDownloadT0" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Download" android:textSize="9sp"/>
                            <Button android:id="@+id/btnLoadT0" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Load" android:textSize="9sp" android:layout_marginStart="4dp"/>
                            <Button android:id="@+id/btnDeleteT0" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Delete" android:textSize="9sp" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <!-- Model T1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Standard (1.5B)"
                                android:textSize="11sp"
                                android:textColor="#334155"/>
                            <Button android:id="@+id/btnDownloadT1" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Download" android:textSize="9sp"/>
                            <Button android:id="@+id/btnLoadT1" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Load" android:textSize="9sp" android:layout_marginStart="4dp"/>
                            <Button android:id="@+id/btnDeleteT1" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Delete" android:textSize="9sp" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnUnload"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:text="Unload Model"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp"/>
                        <Button
                            android:id="@+id/btnOpenRecovery"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:text="Open Recovery Console"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- CITATIONS CARD -->
                <LinearLayout
                    android:id="@+id/layoutCitations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EFF6FF"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 Grounded Knowledge Sources"
                        android:textStyle="bold"
                        android:textColor="#2563EB"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/txtCitations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sources will appear here."
                        android:textSize="11sp"
                        android:textColor="#1E40AF"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- ONLINE LIVE RAG IMAGE CARD (Visible only during online/live RAG when image found) -->
                <LinearLayout
                    android:id="@+id/cardWebImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/imgWebResult"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="#E2E8F0" />
                    <TextView
                        android:id="@+id/txtWebImageCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐 Live Web Entity Image"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- CHAT MESSAGE LOG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Conversation Feed"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/txtChatLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="140dp"
                        android:text="ISHA is ready. Ask any question below or choose a suggestion above."
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= DOCUMENT LIBRARY VIEW ================= -->
        <LinearLayout
            android:id="@+id/viewDocLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Personal Document Library"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Index PDFs, text files, and manuals to chat with your documents offline."
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnPickDoc"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="➕ Ingest New Document"
                    android:backgroundTint="#F59E0B"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <!-- Ingestion Progress -->
                <LinearLayout
                    android:id="@+id/layoutIngestProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/txtIngestStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ingesting..."
                        android:textSize="11sp"
                        android:textColor="#D97706" />
                    <ProgressBar
                        android:id="@+id/progressIngest"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:id="@+id/txtIndexChunks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chunks: 0"
                        android:textSize="12sp"
                        android:textColor="#64748B" />
                    <TextView
                        android:id="@+id/txtIndexSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size: 0 KB"
                        android:textSize="12sp"
                        android:textColor="#64748B" />
                </LinearLayout>
            </LinearLayout>

            <!-- Knowledge Folder Search Bar -->
            <EditText
                android:id="@+id/editDocSearch"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="🔍 Search knowledge packs &amp; documents..."
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="10dp"
                android:singleLine="true" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/layoutDocList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- CONSUMER FLOATING BOTTOM PROMPT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- ATTACHED IMAGE PREVIEW (Google AI Edge Gallery Multimodal Vision Feature) -->
        <LinearLayout
            android:id="@+id/layoutImagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F5F9"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgAttachedPreview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                android:background="#E2E8F0" />

            <TextView
                android:id="@+id/txtAttachedImageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="image.jpg"
                android:textSize="12sp"
                android:textColor="#334155" />

            <Button
                android:id="@+id/btnRemoveImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✖"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:background="@drawable/bg_pill_button"
                style="?android:attr/borderlessButtonStyle" />
        </LinearLayout>

        <!-- INPUT ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <!-- Camera / Image Attachment Button (Multimodal Vision) -->
            <Button
                android:id="@+id/btnAttachImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="📷"
                android:textSize="16sp"
                android:background="@drawable/bg_pill_button"
                android:textColor="#475569"
                android:layout_marginEnd="6dp"
                style="?android:attr/borderlessButtonStyle" />

            <!-- Voice STT Speech-to-Text Button -->
            <Button
                android:id="@+id/btnVoiceInput"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🎙️"
                android:textSize="16sp"
                android:background="@drawable/bg_pill_button"
                android:textColor="#475569"
                android:layout_marginEnd="6dp"
                style="?android:attr/borderlessButtonStyle" />

            <EditText
                android:id="@+id/editPrompt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_input"
                android:hint="Ask ISHA anything..."
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="➤"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#F59E0B"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"
                android:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
